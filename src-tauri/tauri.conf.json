{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio Reader",
  "mainBinaryName": "folioapp",
  "version": "0.0.1-dev",
  "identifier": "com.folio.folioapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Folio Reader",
        "width": 700,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "$APPLOCALDATA/**/*",
            "$APPDATA/**/*",
            "$APPCACHE/**/*",
            "$HOME/**/*",
            "$DOWNLOAD/**/*",
            "$DOCUMENT/**/*",
            "**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Folio",
    "category": "Productivity",
    "shortDescription": "E-book reader for EPUB, FB2, MOBI, CBZ, and PDF",
    "longDescription": "Modern cross-platform e-book reader with cloud sync support.",
    "linux": {
      "deb": {
        "desktopTemplate": "./templates/folioapp.desktop"
      },
      "rpm": {
        "desktopTemplate": "./templates/folioapp.desktop"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".dev"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
